+/// One past the largest valid IP protocol number.
+///
+/// A protocol number outside `0..IPPROTO_MAX` does not name a protocol at all, so the IP
+/// families reject it with `EINVAL` rather than with `EPROTONOSUPPORT`.
+///
+/// From <https://elixir.bootlin.com/linux/v6.0.9/source/include/uapi/linux/in.h>.
+pub const IPPROTO_MAX: i32 = Protocol::IPPROTO_MPTCP as i32 + 1;
+
