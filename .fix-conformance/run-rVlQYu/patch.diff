diff --git a/kernel/src/fs/file/file_handle.rs b/kernel/src/fs/file/file_handle.rs
index c198f25a2..5f109b361 100644
--- a/kernel/src/fs/file/file_handle.rs
+++ b/kernel/src/fs/file/file_handle.rs
@@ -154,6 +154,32 @@ pub trait FileLike: Pollable + Send + Sync + Any {
         None
     }
 
+    /// Returns whether this file type supports event polling.
+    ///
+    /// A file type supports event polling if its readiness can change over time,
+    /// so that [`Pollable::poll`] has an underlying object to report and a
+    /// registered [`PollHandle`] has something to be notified about. Pipes,
+    /// sockets, and TTYs are such file types.
+    ///
+    /// The remaining file types are unconditionally ready: there is nothing to
+    /// wait for, so [`Pollable::poll`] reports a constant `IN | OUT`. Regular
+    /// files, directories, and `/dev/null` are such file types.
+    ///
+    /// Both kinds can be used with `poll`/`select`, which report the latter as
+    /// ready. But only file types that support event polling can be registered in
+    /// an epoll interest list, since epoll exists to report readiness *changes*.
+    /// Linux draws the same line using a `NULL` `f_op->poll`: `vfs_poll`
+    /// substitutes the constant `DEFAULT_POLLMASK` for it, while `file_can_poll`
+    /// reports that the file cannot be epoll-registered.
+    ///
+    /// Reference: <https://elixir.bootlin.com/linux/v6.11/source/include/linux/poll.h#L75-L83>.
+    ///
+    /// [`Pollable::poll`]: crate::process::signal::Pollable::poll
+    /// [`PollHandle`]: crate::process::signal::PollHandle
+    fn supports_event_polling(&self) -> bool {
+        true
+    }
+
     /// Returns the common state shared by file-like objects.
     fn common(&self) -> &FileCommon;
 
