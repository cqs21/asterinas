+    /// The requested access must be granted by exactly _one_ triplet of the mode, selected by
+    /// the caller's credentials: the owner triplet if the caller's EUID owns or created the
+    /// object, otherwise the group triplet if the caller belongs to the object's owning or
+    /// creating group, otherwise the other triplet. The selection is exclusive, so owning an
+    /// object grants no access of its own: an object whose mode is zero denies its owner even
+    /// though the group or other triplets may be permissive.
+    ///
+    /// A caller holding `CAP_IPC_OWNER` in `user_ns` is exempt from the test entirely.
+    ///
+    /// This method must not be used for removing an object or changing its ownership. Those
+    /// ignore the mode and require ownership or `CAP_SYS_ADMIN` instead.
+    ///
+    /// Reference: <https://github.com/torvalds/linux/blob/v6.8/ipc/util.c#L553>.
+    pub fn check_access(
+        &self,
+        required_perm: PermissionMode,
+        user_ns: &UserNamespace,
+        posix_thread: &PosixThread,
+    ) -> Result<()> {
