+
+impl PermissionMode {
+    /// Folds the read/write/execute triplets of `mode` into the access they request.
+    ///
+    /// This mirrors `requested_mode = (flag >> 6) | (flag >> 3) | flag` in Linux's
+    /// `ipcperms()`, and is how a user-supplied mode (e.g., the low nine bits of `semflg`)
+    /// becomes a request.
+    pub fn from_mode(mode: u16) -> Self {
+        Self::from_bits_truncate((mode >> 6) | (mode >> 3) | mode)
+    }
