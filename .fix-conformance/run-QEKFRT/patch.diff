+    ///
+    /// The bits are the read/write/execute triplet _folded_ into the low three bits, matching
+    /// the `requested_mode` of Linux's `ipcperms()`. They are compared against a single triplet
+    /// of the object's mode, so they must not be confused with the object's mode itself.
+    pub struct PermissionMode: u16{
+        /// Executing, which is meaningless for every IPC object type but is kept so that
+        /// folding a user-supplied mode never silently drops a bit.
+        const EXEC   = 0o001;
+        const ALTER  = 0o002;
+        const WRITE  = 0o002;
+        const READ   = 0o004;
+    }
