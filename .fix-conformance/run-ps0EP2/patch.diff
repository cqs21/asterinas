+    /// Swaps which inodes the `old_name` and `new_name` entries refer to.
+    ///
+    /// Unlike a replacing rename, both participants survive: no entry is added
+    /// or deleted, no link count is dropped, and no inode is freed. Only the
+    /// two entries' inode and file type fields, the two participants' `..`
+    /// entries when the exchange crosses directories, and timestamps change.
+    fn apply_exchange_mutations(
+        &self,
+        guards: &mut MultiInodeInnerGuards,
+        target: &Inode,
+        old_name: &str,
+        old_inode: &Inode,
+        exchanged_inode: &Inode,
+        new_name: &str,
+    ) -> Result<()> {
+        let old_ino = old_inode.ino();
+        let exchanged_ino = exchanged_inode.ino();
+        let old_is_dir = old_inode.type_ == InodeType::Dir;
+        let exchanged_is_dir = exchanged_inode.type_ == InodeType::Dir;
+        let old_file_type = DirEntryFileType::from(old_inode.type_);
+        let exchanged_file_type = DirEntryFileType::from(exchanged_inode.type_);
+        let is_same_dir = self.ino == target.ino;
+
+        // A cross-directory exchange moves each participant into the other
+        // parent. The parents' link counts only shift when exactly one
+        // participant is a directory, because otherwise the `..` link each
+        // parent gains is cancelled by the one it loses.
+        let moves_parent_links = !is_same_dir && old_is_dir != exchanged_is_dir;
+        // The parent that ends up holding the single directory gains its `..` link.
+        let (link_gaining_ino, link_losing_ino) = if exchanged_is_dir {
+            (self.ino, target.ino)
+        } else {
+            (target.ino, self.ino)
+        };
+
+        // Step 4.1: locate every entry the swap will write and reject the
+        // link count overflow up front. There is no journal to roll back a
+        // partially applied exchange, so all fallible work happens here,
+        // before the first mutation. This mirrors Linux's
+        // `ext4_rename_dir_prepare`, which likewise resolves the `..` blocks
+        // before `ext4_setent` touches anything.
+        let old_entry = guards.inner(self.ino).find_entry_info(old_name)?;
+        let new_entry = guards.inner(target.ino).find_entry_info(new_name)?;
+        let old_dotdot_entry = if !is_same_dir && old_is_dir {
+            Some(guards.inner(old_ino).find_entry_info("..")?)
+        } else {
+            None
+        };
+        let exchanged_dotdot_entry = if !is_same_dir && exchanged_is_dir {
+            Some(guards.inner(exchanged_ino).find_entry_info("..")?)
+        } else {
+            None
+        };
+        if moves_parent_links && guards.inner(link_gaining_ino).link_count() >= MAX_LINK_COUNT {
+            return_errno!(Errno::EMLINK);
+        }
+
+        // Step 4.2: cross the two entries' inode targets. Both entries already
+        // exist, so neither write allocates or grows a directory block, and
+        // nothing fallible sits between them.
+        guards.inner_mut(self.ino).set_entry_target(
+            &old_entry,
+            exchanged_ino,
+            exchanged_file_type,
+        )?;
+        guards
+            .inner_mut(target.ino)
+            .set_entry_target(&new_entry, old_ino, old_file_type)?;
+
+        // Step 4.3: repoint each moved directory's `..` at its new parent.
+        let now = utils::now();
+        if let Some(dotdot_entry) = old_dotdot_entry {
+            let old_inner = guards.inner_mut(old_ino);
+            old_inner.set_entry_target(&dotdot_entry, target.ino, DirEntryFileType::Dir)?;
+            old_inner.remove_flags(FileFlags::INDEX_DIR);
+            old_inner.set_mtime_ctime(now);
+        }
+        if let Some(dotdot_entry) = exchanged_dotdot_entry {
+            let exchanged_inner = guards.inner_mut(exchanged_ino);
+            exchanged_inner.set_entry_target(&dotdot_entry, self.ino, DirEntryFileType::Dir)?;
+            exchanged_inner.remove_flags(FileFlags::INDEX_DIR);
+            exchanged_inner.set_mtime_ctime(now);
+        }
+
+        // Step 4.4: update timestamps and, if the exchange moved a lone
+        // directory across parents, the two parents' link counts.
+        guards.inner_mut(old_ino).set_ctime(now);
+        guards.inner_mut(exchanged_ino).set_ctime(now);
+        guards.inner_mut(self.ino).set_mtime_ctime(now);
+        if !is_same_dir {
+            guards.inner_mut(target.ino).set_mtime_ctime(now);
+        }
+        if moves_parent_links {
+            guards.inner_mut(link_gaining_ino).inc_link_count(1);
+            guards.inner_mut(link_losing_ino).dec_link_count(1);
+        }
+
+        Ok(())
+    }
