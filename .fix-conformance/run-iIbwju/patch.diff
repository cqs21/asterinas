diff --git a/kernel/src/syscall/clock_getres.rs b/kernel/src/syscall/clock_getres.rs
new file mode 100644
index 000000000..3b000eed4
--- /dev/null
+++ b/kernel/src/syscall/clock_getres.rs
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: MPL-2.0
+
+use ostd::mm::VmIo;
+
+use super::{SyscallReturn, clock_gettime::with_clock};
+use crate::{
+    prelude::*,
+    time::{clockid_t, timespec_t},
+};
+
+pub fn sys_clock_getres(
+    clockid: clockid_t,
+    timespec_addr: Vaddr,
+    ctx: &Context,
+) -> Result<SyscallReturn> {
+    debug!("clockid = {:?}", clockid);
+
+    // The clock ID is validated first, through the same path `sys_clock_gettime` uses, so that
+    // the two calls cannot disagree about which clock IDs are valid.
+    let resolution = with_clock(clockid, ctx, |clock| clock.resolution())?;
+
+    // A null pointer is not an error: the caller may only want to know whether the clock
+    // exists. This matches Linux, which guards the copy-out with `if (!error && tp)`.
+    if timespec_addr != 0 {
+        let timespec = timespec_t::from(resolution);
+        ctx.user_space().write_val(timespec_addr, &timespec)?;
+    }
+
+    Ok(SyscallReturn::Return(0))
+}
