diff --git a/kernel/src/time/core/mod.rs b/kernel/src/time/core/mod.rs
index f86f5a855..50ad96c68 100644
--- a/kernel/src/time/core/mod.rs
+++ b/kernel/src/time/core/mod.rs
@@ -2,11 +2,40 @@
 
 use core::time::Duration;
 
+use ostd::timer::TIMER_FREQ;
+
 pub mod timer;
 
+/// The resolution of the clocks that are derived from the high-resolution clocksource.
+///
+/// Such a clock computes its time from the clocksource on each read, so the finest
+/// difference it can report is one nanosecond. This mirrors Linux's `hrtimer_resolution`,
+/// which is also one nanosecond whenever high-resolution timers are available.
+pub const HIGH_RES_CLOCK_RESOLUTION: Duration = Duration::from_nanos(1);
+
+/// The resolution of the clocks that are advanced by the timer interrupt.
+///
+/// Such a clock only changes once per tick, so its resolution is the tick period. This is
+/// the counterpart of Linux's `TICK_NSEC`, which is likewise `1 / CONFIG_HZ`.
+pub const TICK_CLOCK_RESOLUTION: Duration = Duration::from_nanos(1_000_000_000 / TIMER_FREQ);
+
 /// A trait that can abstract clocks which have the ability to read time,
 /// and has a fixed resolution.
 pub trait Clock: Send + Sync {
     /// Read the current time of this clock.
     fn read_time(&self) -> Duration;
+
+    /// Returns the resolution of this clock.
+    ///
+    /// The resolution is the smallest difference between two times that this clock can
+    /// report. It is a property of the clock itself, so every consumer that has to name a
+    /// clock's resolution -- `clock_getres`, the vDSO data page -- must obtain it from
+    /// here, rather than deciding on one of its own.
+    ///
+    /// The default is [`HIGH_RES_CLOCK_RESOLUTION`], which suits any clock that reads the
+    /// high-resolution clocksource. Clocks that are instead advanced by the timer tick
+    /// must override this method.
+    fn resolution(&self) -> Duration {
+        HIGH_RES_CLOCK_RESOLUTION
+    }
 }
