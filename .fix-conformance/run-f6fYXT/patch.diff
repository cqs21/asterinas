@@ -14,10 +14,10 @@ pub fn sys_timerfd_gettime(
     itimerspec_addr: Vaddr,
     ctx: &Context,
 ) -> Result<SyscallReturn> {
-    if itimerspec_addr == 0 {
-        return_errno_with_message!(Errno::EINVAL, "invalid pointer to return value");
-    }
-
+    // The FD must be fully validated before the user pointer is touched, so that
+    // FD errors (`EBADF`, then `EINVAL` for a non-timerfd) take precedence over
+    // pointer errors (`EFAULT`). A null pointer is not a distinct error condition:
+    // it is an unmapped address, reported as `EFAULT` by the user-space write below.
     let file_table = ctx.thread_local.borrow_file_table();
     let file_table_locked = file_table.unwrap().read();
     let timerfd_file = file_table_locked.get_file(raw_fd.try_into()?)?;
