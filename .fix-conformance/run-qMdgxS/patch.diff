+// The base address of a buffer is validated for _every_ entry of the I/O vector, including the
+// empty ones, and no data is transferred if any entry is invalid. Meanwhile, a null base address
+// is not invalid by itself: a buffer with a null base and a non-zero length must be accessed, and
+// the access then fails because the address is not mapped.
+FN_TEST(bad_iov_base)
+{
+	const char *file_path = "/tmp/iovec_err_bad_base";
+	int fd;
+	struct iovec iov[2];
+
+	fd = TEST_SUCC(open(file_path, O_RDWR | O_CREAT | O_TRUNC, 0600));
+	TEST_RES(write(fd, "0123456789", 10), _ret == 10);
+
+	// A null base with a zero length transfers nothing and succeeds.
+	iov[0] = (struct iovec){ .iov_base = NULL, .iov_len = 0 };
+	TEST_RES(readv(fd, iov, 1), _ret == 0);
+	TEST_RES(writev(fd, iov, 1), _ret == 0);
+
+	// A null base with a zero length does not stop the other entries.
+	iov[0] = (struct iovec){ .iov_base = NULL, .iov_len = 0 };
+	iov[1] = (struct iovec){ .iov_base = buf, .iov_len = sizeof(buf) };
+	TEST_SUCC(lseek(fd, 0, SEEK_SET));
+	TEST_RES(readv(fd, iov, 2), _ret == 10);
+
+	// An out-of-range base fails the whole call even at a zero length, and
+	// even when it is not the first entry. Since nothing is transferred, the
+	// valid entry alongside it is left untouched.
+	iov[0] =
+		(struct iovec){ .iov_base = (void *)UINTPTR_MAX, .iov_len = 0 };
+	iov[1] = (struct iovec){ .iov_base = buf, .iov_len = sizeof(buf) };
+	TEST_SUCC(lseek(fd, 0, SEEK_SET));
+	TEST_ERRNO(readv(fd, iov, 2), EFAULT);
+	TEST_ERRNO(writev(fd, iov, 2), EFAULT);
+
+	iov[0] = (struct iovec){ .iov_base = buf, .iov_len = sizeof(buf) };
+	iov[1] =
+		(struct iovec){ .iov_base = (void *)UINTPTR_MAX, .iov_len = 0 };
+	TEST_SUCC(lseek(fd, 0, SEEK_SET));
+	TEST_ERRNO(readv(fd, iov, 2), EFAULT);
+	TEST_ERRNO(writev(fd, iov, 2), EFAULT);
+
+	// An invalid length is reported as `EINVAL` even if another entry also
+	// has an invalid base address, because all lengths are validated before
+	// any base address is.
+	iov[0] =
+		(struct iovec){ .iov_base = (void *)UINTPTR_MAX, .iov_len = 0 };
+	iov[1] = (struct iovec){ .iov_base = buf, .iov_len = -1234 };
+	TEST_ERRNO(readv(fd, iov, 2), EINVAL);
+	TEST_ERRNO(writev(fd, iov, 2), EINVAL);
+
+	// A null base with a non-zero length is not an empty buffer: it must be
+	// accessed, and the access then reports `EFAULT` rather than a
+	// successful transfer of zero bytes. These come last because a faulting
+	// transfer leaves the file offset and size unspecified.
+	iov[0] = (struct iovec){ .iov_base = NULL, .iov_len = sizeof(buf) };
+	TEST_SUCC(lseek(fd, 0, SEEK_SET));
+	TEST_ERRNO(readv(fd, iov, 1), EFAULT);
+	TEST_SUCC(lseek(fd, 0, SEEK_SET));
+	TEST_ERRNO(writev(fd, iov, 1), EFAULT);
+
+	TEST_SUCC(close(fd));
+	TEST_SUCC(unlink(file_path));
+}
+END_TEST()
