+    /// Checks a write at `offset` against `RLIMIT_FSIZE` and limits `reader` accordingly.
+    ///
+    /// The limit bounds how many bytes a file may hold, so it is evaluated against the
+    /// *starting* offset of the write rather than against its end:
+    /// - If the offset is at or beyond the soft limit, nothing is transferred, `EFBIG` is
+    ///   returned and `SIGXFSZ` is raised on the calling thread.
+    /// - Otherwise the write is permitted, but `reader` is limited so that at most
+    ///   `limit - offset` bytes are transferred. This is an ordinary short write, with
+    ///   neither an error nor a signal.
+    ///
+    /// This mirrors Linux's `generic_write_check_limits`, which every regular-file write
+    /// path reaches via `generic_write_checks`.
+    /// Reference: <https://elixir.bootlin.com/linux/v6.16.9/source/fs/read_write.c>.
+    ///
+    /// The limit applies only to writes that can grow a file's contents, i.e. to regular
+    /// files whose bytes live in a page cache. Writes to devices, pipes and sockets do
+    /// not store bytes in a file, and pseudo-filesystem writes (procfs, sysfs) address
+    /// kernel state rather than file contents -- most notably `/proc/[pid]/mem`, whose
+    /// offsets are user-space addresses and would otherwise be rejected outright. Linux
+    /// likewise reaches `generic_write_checks` from real filesystems only.
+    fn check_fsize_limit(&self, offset: usize, reader: &mut VmReader) -> Result<()> {
+        // A zero-length write never extends the file, so it can never hit the limit.
+        if !reader.has_remain() {
+            return Ok(());
+        }
+
+        // Impose no limit if there is no process to read the limit from, as is the case
+        // in kernel-mode unit tests.
+        let current_thread = Thread::current();
+        let Some(posix_thread) = current_thread
+            .as_ref()
+            .and_then(|thread| thread.as_posix_thread())
+        else {
+            return Ok(());
+        };
+
+        let limit = posix_thread
+            .process()
+            .resource_limits()
+            .get_rlimit(ResourceType::RLIMIT_FSIZE)
+            .get_cur();
+        // The limit is unset in the common case. Return early before querying the inode,
+        // so that the checks below cost nothing unless a limit is actually in effect.
+        if limit == RLIM_INFINITY {
+            return Ok(());
+        }
+
+        let inode = self.path().inode();
+        if !inode.type_().is_regular_file() || inode.page_cache().is_none() {
+            return Ok(());
+        }
+
+        if offset as u64 >= limit {
+            posix_thread.enqueue_signal(Box::new(UserSignal::new(
+                SIGXFSZ,
+                UserSignalKind::Kill,
+                posix_thread.process().pid(),
+                posix_thread.credentials().ruid(),
+            )));
+            return_errno_with_message!(
+                Errno::EFBIG,
+                "the write offset is at or beyond the maximum file size"
+            );
+        }
+
+        let writable_len = limit - offset as u64;
+        reader.limit(writable_len.try_into().unwrap_or(usize::MAX));
+
+        Ok(())
+    }
+
