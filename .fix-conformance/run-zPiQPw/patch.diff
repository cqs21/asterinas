+/// The number of the control characters in the legacy [`CTermio`].
+///
+/// Reference: <https://elixir.bootlin.com/linux/v6.0.9/source/include/uapi/linux/termios.h#L10>.
+const NUM_LEGACY_CTRL_CHARS: usize = 8;
+
+/// The legacy termios; `struct termio` in Linux.
+///
+/// This is the System V-era counterpart of [`CTermios`]. The kernel state is always a
+/// [`CTermios2`]; this type exists only as a userspace representation, which differs by
+/// narrowing the four flag words to 16 bits and carrying only the first
+/// [`NUM_LEGACY_CTRL_CHARS`] control characters. So the conversions below are the entire
+/// difference between the `TCGETA` family and the `TCGETS` family.
+///
+/// Reference: <https://elixir.bootlin.com/linux/v6.0.9/source/include/uapi/linux/termios.h#L12>.
+#[padding_struct]
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Pod)]
+pub struct CTermio {
+    c_iflags: u16,
+    c_oflags: u16,
+    c_cflags: u16,
+    c_lflags: u16,
+    c_line: CCtrlChar,
+    c_cc: [CCtrlChar; NUM_LEGACY_CTRL_CHARS],
+}
+
+// The size is part of the userspace ABI: it is how many bytes `TCGETA` copies out and `TCSETA`
+// copies in. Note that the legacy ioctl numbers do not encode a size, so nothing else checks it.
+const_assert!(size_of::<CTermio>() == 18);
+
+impl From<&CTermios> for CTermio {
+    fn from(termios: &CTermios) -> Self {
+        let mut termio: Self = FromZeros::new_zeroed();
+
+        termio.c_iflags = termios.c_iflags.bits() as u16;
+        termio.c_oflags = termios.c_oflags.bits() as u16;
+        termio.c_cflags = termios.c_cflags.0 as u16;
+        termio.c_lflags = termios.c_lflags.bits() as u16;
+        termio.c_line = termios.c_line;
+        termio
+            .c_cc
+            .copy_from_slice(&termios.c_cc[..NUM_LEGACY_CTRL_CHARS]);
+
+        termio
+    }
+}
+
+impl CTermio {
+    /// Returns the [`CTermios`] that results from applying `self` to `termios`.
+    ///
+    /// Only the low 16 bits of each flag word and the first [`NUM_LEGACY_CTRL_CHARS`] control
+    /// characters can be expressed in the legacy representation, so the rest of `termios` is
+    /// carried over unchanged. This mirrors Linux's `user_termio_to_kernel_termios`.
+    pub(super) fn apply_to(&self, termios: &CTermios) -> CTermios {
+        /// Replaces the low 16 bits of a flag word, keeping the high 16 bits.
+        fn merge_low_bits<T: Pod>(old: &T, new_low_bits: u16) -> T {
+            const { assert!(size_of::<T>() == size_of::<u32>()) };
+
+            let old_bits = u32::from_bytes(old.as_bytes());
+            let bits = (old_bits & !(u16::MAX as u32)) | (new_low_bits as u32);
+            T::from_bytes(bits.as_bytes())
+        }
+
+        let mut termios = *termios;
+
+        termios.c_iflags = merge_low_bits(&termios.c_iflags, self.c_iflags);
+        termios.c_oflags = merge_low_bits(&termios.c_oflags, self.c_oflags);
+        termios.c_cflags = merge_low_bits(&termios.c_cflags, self.c_cflags);
+        termios.c_lflags = merge_low_bits(&termios.c_lflags, self.c_lflags);
+        termios.c_line = self.c_line;
+        termios.c_cc[..NUM_LEGACY_CTRL_CHARS].copy_from_slice(&self.c_cc);
+
+        termios
+    }
+}
+
