+/// The initial owner and mode that a newly created inode must start with.
+///
+/// A filesystem never derives these attributes itself. The VFS resolves them
+/// once, via [`NewInodeAttrs::resolve`], and hands the result down to
+/// [`Inode::create`], [`Inode::mknod`] and [`Inode::create_tmpfile`]. This keeps
+/// the set-group-ID inheritance policy in a single place, above every
+/// filesystem, and makes the resolved mode the only mode a filesystem can see.
+#[derive(Clone, Copy, Debug)]
+pub struct NewInodeAttrs {
+    uid: Uid,
+    gid: Gid,
+    mode: InodeMode,
+}
+
+impl NewInodeAttrs {
+    /// Creates attributes with an explicitly chosen owner.
+    ///
+    /// Use this only when the owner is already known and must not be derived
+    /// from the current credentials or the parent directory, e.g. when a stacked
+    /// filesystem forwards an already-resolved creation downwards. Ordinary
+    /// creation paths use [`Self::resolve`] instead.
+    pub fn new(uid: Uid, gid: Gid, mode: InodeMode) -> Self {
+        Self { uid, gid, mode }
+    }
+
+    pub fn uid(&self) -> Uid {
+        self.uid
+    }
+
+    pub fn gid(&self) -> Gid {
+        self.gid
+    }
+
+    pub fn mode(&self) -> InodeMode {
+        self.mode
+    }
+
+    /// Resolves the attributes of a new inode of `type_` created in `parent`
+    /// with the requested `mode`.
+    ///
+    /// The owner user ID is always the creator's filesystem user ID. The group
+    /// ID and the set-group-ID bit follow the set-group-ID directory rule:
+    /// - If `parent` has set-group-ID set, the new inode takes `parent`'s group
+    ///   ID rather than the creator's filesystem group ID. This is
+    ///   unconditional: no group membership or capability gates it.
+    ///   - A new directory additionally takes set-group-ID, so the rule keeps
+    ///     applying further down the subtree.
+    ///   - A new non-directory never gains set-group-ID. A set-group-ID
+    ///     explicitly requested in `mode` is stripped unless the creator can
+    ///     set it on the inherited group.
+    /// - Otherwise, the new inode takes the creator's filesystem group ID and
+    ///   the requested `mode` is used as is.
+    pub fn resolve(parent: &dyn Inode, type_: InodeType, mode: InodeMode) -> Result<Self> {
+        let (fsuid, fsgid) = current_fs_ids();
+
+        let parent_metadata = parent.metadata()?;
+        if !parent_metadata.mode.has_set_gid() {
+            return Ok(Self::new(fsuid, fsgid, mode));
+        }
+
+        let gid = parent_metadata.gid;
+        let mode = if type_ == InodeType::Dir {
+            mode | InodeMode::S_ISGID
+        } else if mode.has_set_gid() && mode.is_group_executable() && !can_set_gid_bit(gid) {
+            mode - InodeMode::S_ISGID
+        } else {
+            mode
+        };
+
+        Ok(Self::new(fsuid, gid, mode))
+    }
+}
+
+/// Returns the filesystem user and group IDs of the current thread.
+///
+/// Creation paths that run without a userspace thread, e.g. populating the
+/// initial ramfs, act as the root user.
+fn current_fs_ids() -> (Uid, Gid) {
+    Task::current()
+        .and_then(|task| {
+            let credentials = task.as_posix_thread()?.credentials();
+            Some((credentials.fsuid(), credentials.fsgid()))
+        })
+        .unwrap_or((Uid::new_root(), Gid::new_root()))
+}
+
+/// Returns whether the current thread may set the set-group-ID bit on an inode
+/// owned by the group `gid`.
+///
+/// This holds if the thread is a member of `gid`, or if it has the `CAP_FSETID`
+/// capability.
+fn can_set_gid_bit(gid: Gid) -> bool {
+    let Some(task) = Task::current() else {
+        return true;
+    };
+    let Some(posix_thread) = task.as_posix_thread() else {
+        return true;
+    };
+
+    let credentials = posix_thread.credentials();
+    if credentials.fsgid() == gid || credentials.groups().contains(&gid) {
+        return true;
+    }
+
+    let thread_local = task.as_thread_local().unwrap();
+    let user_ns = thread_local.borrow_user_ns();
+    lsm_hooks::on_capable(lsm_hooks::CapableContext::new(
+        user_ns.as_ref(),
+        posix_thread,
+        CapSet::FSETID,
+    ))
+    .is_ok()
 }
 
