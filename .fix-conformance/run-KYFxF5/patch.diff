+
+    /// Checks that the current user owns this inode, or is privileged enough to act as if it
+    /// did.
+    ///
+    /// Ownership is decided by "fsuid", as in [`Self::check_permission`], and `CAP_FOWNER`
+    /// grants the same authority as ownership. The file mode is deliberately not consulted:
+    /// this answers "may the caller exercise owner-only privileges on this inode", which is a
+    /// different question from whether the caller may read, write or execute it.
+    ///
+    /// Similar to Linux's `inode_owner_or_capable`.
+    fn check_owner_or_capable(&self) -> Result<()> {
+        let Some(task) = Task::current() else {
+            return Ok(());
+        };
+        let Some(posix_thread) = task.as_posix_thread() else {
+            return Ok(());
+        };
+
+        if self.metadata()?.uid == posix_thread.credentials().fsuid() {
+            return Ok(());
+        }
+
+        let thread_local = task.as_thread_local().unwrap();
+        let user_ns = thread_local.borrow_user_ns();
+        lsm_hooks::on_capable(lsm_hooks::CapableContext::new(
+            user_ns.as_ref(),
+            posix_thread,
+            CapSet::FOWNER,
+        ))
+        .map_err(|_| Error::with_message(Errno::EPERM, "the caller does not own the inode"))
+    }
 }
 
