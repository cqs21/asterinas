+    /// Checks whether `posix_thread` may access the object with the `requested` access rights.
+    ///
+    /// Exactly one triplet of the object's mode applies: the owner triplet if the caller's
+    /// effective UID owns or created the object, otherwise the group triplet if the object's owning
+    /// or creating group is one of the caller's groups, otherwise the "other" triplet. Holding
+    /// `CAP_IPC_OWNER` in `owner_ns` overrides the mode.
+    ///
+    /// This mirrors Linux's `ipcperms()` in `ipc/util.c`, including its use of the effective UID
+    /// for the owner test but the filesystem GID (plus the supplementary groups) for the group
+    /// test.
+    pub fn check_access(
+        &self,
+        requested: PermissionMode,
+        credentials: &Credentials<ReadOp>,
+        owner_ns: &Arc<UserNamespace>,
+        posix_thread: &PosixThread,
+    ) -> Result<()> {
+        let requested_bits = requested.bits() & 0o7;
+
+        // Shift the applicable triplet down to the low bits. If neither the owner nor the group
+        // matches, the mode is left unshifted so that the "other" triplet applies.
+        let granted_mode = if credentials.euid() == self.uid || credentials.euid() == self.cuid {
+            self.mode >> 6
+        } else if self.is_in_group_of(credentials) {
+            self.mode >> 3
+        } else {
+            self.mode
+        };
+
+        let granted_bits = granted_mode & 0o7;
+
+        if requested_bits & !granted_bits == 0 {
+            return Ok(());
+        }
+
+        // The mode bits do not grant the access. `CAP_IPC_OWNER` in the object's user namespace
+        // overrides the mode check; without it the access is denied with `EACCES`, which is the
+        // errno all IPC lookup paths report for a permission failure.
+        let is_capable = lsm_hooks::on_capable(lsm_hooks::CapableContext::new(
+            owner_ns.as_ref(),
+            posix_thread,
+            CapSet::IPC_OWNER,
+        ))
+        .is_ok();
+        if !is_capable {
+            return_errno_with_message!(
+                Errno::EACCES,
+                "the caller is not allowed to access the IPC object"
+            );
+        }
+
+        Ok(())
+    }
+
+    /// Returns whether the object's owning or creating group is one of the caller's groups.
+    ///
+    /// This mirrors Linux's `in_group_p()`, which tests the filesystem GID before searching the
+    /// supplementary group set.
+    fn is_in_group_of(&self, credentials: &Credentials<ReadOp>) -> bool {
+        let fsgid = credentials.fsgid();
+        if fsgid == self.gid || fsgid == self.cguid {
+            return true;
+        }
+
+        let groups = credentials.groups();
+        groups.contains(&self.gid) || groups.contains(&self.cguid)
+    }
