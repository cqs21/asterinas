index 133096794..c9d794a6f 100644
--- a/kernel/src/context.rs
+++ b/kernel/src/context.rs
@@ -226,6 +226,38 @@ impl<'a> CurrentUserSpace<'a> {
                 )
             })
     }
+
+    /// Reads a C string from the user space, truncating it if it exceeds the maximum length.
+    ///
+    /// This method behaves like [`Self::read_cstring`], except that an over-long string is not
+    /// an error: the returned C string contains at most `max_len - 1` bytes, silently truncated.
+    ///
+    /// This matches Linux's `strncpy_from_user`, which reports an error only if the string cannot
+    /// be read. It is correct for fixed-size kernel name fields, such as the thread name set by
+    /// `prctl(PR_SET_NAME)`, where Linux truncates silently rather than rejecting an over-long name.
+    pub fn read_cstring_truncated(&self, vaddr: Vaddr, max_len: usize) -> Result<CString> {
+        let read_len = max_len.saturating_sub(1);
+        if read_len > 0 {
+            check_vaddr_lowerbound(vaddr)?;
+        }
+
+        let userspace_max_len = VMAR_CAP_ADDR.saturating_sub(vaddr).min(read_len);
+
+        let mut user_reader = self.reader(vaddr, userspace_max_len)?;
+        let (cstring, bytes_read) = user_reader.read_cstring_until_end(userspace_max_len)?;
+
+        // If no nul byte was found and the read window was clamped by the address space limit,
+        // the string runs off the end of user space, which is an error per Linux's behavior.
+        let nul_found = bytes_read == cstring.as_bytes_with_nul().len();
+        if !nul_found && userspace_max_len != read_len {
+            return_errno_with_message!(
+                Errno::EFAULT,
+                "the C string does not end before reaching the maximum userspace virtual address"
+            );
+        }
+
+        Ok(cstring)
+    }
 }
 
