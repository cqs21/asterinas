diff --git a/kernel/src/process/priority.rs b/kernel/src/process/priority.rs
new file mode 100644
index 000000000..6fe8eafe3
--- /dev/null
+++ b/kernel/src/process/priority.rs
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: MPL-2.0
+
+//! Permission checks for changing the scheduling priority of a process.
+
+use super::{Process, credentials::capabilities::CapSet, posix_thread::AsPosixThread};
+use crate::{prelude::*, security::lsm::hooks as lsm_hooks};
+
+/// Checks whether the current thread is authorized to change the scheduling
+/// priority of the target process.
+///
+/// The current thread is authorized if its effective UID matches the real or
+/// the effective UID of the target process, or if it has the `SYS_NICE`
+/// capability in the target process's user namespace.
+///
+/// This check answers whether the target may be touched at all. It says nothing
+/// about whether the requested priority itself is permitted, which is subject to
+/// the resource limits of the target process and must be checked afterwards.
+// Reference: `set_one_prio_perm` in <https://elixir.bootlin.com/linux/v6.17/source/kernel/sys.c>.
+pub fn check_set_priority_perm(target_process: &Process, ctx: &Context) -> Result<()> {
+    // The nice value is a per-process attribute, so the credentials of the main
+    // thread represent the credentials of the target process.
+    let target_cred = target_process
+        .main_thread()
+        .as_posix_thread()
+        .unwrap()
+        .credentials();
+    let current_euid = ctx.posix_thread.credentials().euid();
+
+    if current_euid == target_cred.ruid() || current_euid == target_cred.euid() {
+        return Ok(());
+    }
+
+    if lsm_hooks::on_capable(lsm_hooks::CapableContext::new(
+        target_process.user_ns().lock().as_ref(),
+        ctx.posix_thread,
+        CapSet::SYS_NICE,
+    ))
+    .is_ok()
+    {
+        return Ok(());
+    }
+
+    return_errno_with_message!(
+        Errno::EPERM,
+        "changing the scheduling priority of the target process is not allowed"
+    )
+}
