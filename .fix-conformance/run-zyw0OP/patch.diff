+    /// Returns whether this epoll file is reachable from `from` in the epoll interest graph.
+    ///
+    /// The interest graph is the directed graph whose nodes are epoll files and whose edges run
+    /// from an epoll file to each epoll file in its interest list. Adding an edge from this epoll
+    /// file to `from` would close a cycle exactly if this method returns true.
+    ///
+    /// The walk starts at `from`'s interest list rather than at `from` itself, so `from == self` is
+    /// _not_ reported as reachable: a file description registered in its own interest list is a
+    /// distinct rule with a distinct error code (`EINVAL`), enforced before this check.
+    ///
+    /// Reference: <https://elixir.bootlin.com/linux/v6.17/source/fs/eventpoll.c#L2153-L2190>.
+    fn is_reachable_from(&self, from: &EpollFile) -> bool {
+        // Nodes whose interest lists are yet to be walked, and nodes already walked. Both hold
+        // strong references, so that a file cannot be dropped and its address reused by another
+        // epoll file while the walk is in progress.
+        let mut pending = from.epoll_files_in_interest();
+        let mut visited = BTreeSet::new();
+
+        while let Some(node) = pending.pop() {
+            let Some(epoll_file) = node.downcast_ref::<EpollFile>() else {
+                continue;
+            };
+
+            if core::ptr::eq(epoll_file, self) {
+                return true;
+            }
+
+            // The graph may already contain a cycle built before this check existed, and an
+            // acyclic graph can still reach one node by several paths. Either way, nodes must not
+            // be expanded twice, or the walk itself may not terminate.
+            if !visited.insert(KeyableArc::from(node.clone())) {
+                continue;
+            }
+
+            pending.extend(epoll_file.epoll_files_in_interest());
+        }
+
+        false
+    }
+
+    /// Collects the epoll files in the interest list of this epoll file.
+    ///
+    /// Entries whose files have been dropped are skipped, as are entries that are not epoll files:
+    /// neither can contribute an edge to the epoll interest graph.
+    fn epoll_files_in_interest(&self) -> Vec<Arc<dyn FileLike>> {
+        self.interest
+            .lock()
+            .iter()
+            .filter_map(|EntryHolder(entry)| entry.file_weak().upgrade())
+            .map(Arc::<dyn FileLike>::from)
+            .filter(|file| file.downcast_ref::<EpollFile>().is_some())
+            .collect()
+    }
